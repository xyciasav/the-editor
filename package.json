{
  "name": "the-editor",
  "version": "0.1.0",
  "description": "Windows-first photography workflow powered by darktable",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && electron .\"",
    "build": "vite build",
    "dist": "npm run build && electron-builder --win nsis",
    "test": "npm run build"
  },
  "dependencies": {
    "@vitejs/plugin-react": "6.0.2",
    "vite": "8.0.13",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "concurrently": "9.2.1",
    "electron": "38.2.0",
    "electron-builder": "26.0.12",
    "wait-on": "9.0.1"
  },
  "build": {
    "appId": "studio.capturethechapter.editor",
    "productName": "The Editor",
    "directories": { "output": "release" },
    "files": ["dist/**/*", "electron/**/*", "package.json"],
    "win": { "target": "nsis", "artifactName": "The-Editor-Setup-${version}.${ext}", "signAndEditExecutable": false },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true }
  }
}
